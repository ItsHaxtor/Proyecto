                    <Property name="rows" type="int" value="5"/>
                    <Property name="text" type="java.lang.String" value="Genero: Comedia/Romance&#xa;Adaptacion: +18&#xa;Una divertida comedia rom&#xe1;ntica &#xa;protagonizada por una oveja muy&#xa;particular que, cansada de su vida&#xa;rutinaria, decide buscar el amor. &#xa;"/>
