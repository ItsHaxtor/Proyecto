                      <Font name="Sans Serif Collection" size="10" style="1"/>
                    </Property>
                    <Property name="rows" type="int" value="5"/>
                    <Property name="text" type="java.lang.String" value="Genero: Acci&#xf3;n&#xa;Adaptacion: Todo P&#xfa;blico&#xa;Un joven adquiere extraordinarios&#xa; poderes despu&#xe9;s de ser mordido &#xa;por una ara&#xf1;a. Mientras aprende&#xa; a controlar sus habilidades, &#xa;deber&#xe1; proteger a la ciudad y&#xa; comprender que todo gran poder&#xa; conlleva una gran responsabilidad."/>
                  </Properties>
                </Component>
